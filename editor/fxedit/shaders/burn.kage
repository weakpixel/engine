//kage:unit pixels

// Burn: the particle burns away along a ragged, glowing edge instead of
// fading. The tint's alpha is the part that has not burned yet: let it run
// from opaque at birth (Color) to transparent at death (EndColor). The
// tint's color is the color of the unburned part. A FadeIn makes particles
// form out of embers; a FadeOut burns the rest faster at the end.
// RandomRotation gives every particle its own burn pattern.

package main

// +shader:param:slot=x,label=Glow,min=0,max=0.5,default=0.12
// +shader:param:slot=yzw,label=Ember,default=#ff8a20
var Params vec4

// hash returns a stable pseudo-random value in [0,1) for a lattice point.
func hash(p vec2) float {
	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453)
}

// noise is smooth value noise: hash values blended between lattice points.
func noise(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3 - 2*f)
	a := hash(i)
	b := hash(i + vec2(1, 0))
	c := hash(i + vec2(0, 1))
	d := hash(i + vec2(1, 1))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	tex := imageSrc0At(src)
	if color.a <= 0 || tex.a <= 0 {
		return vec4(0)
	}
	burned := 1 - color.a
	uv := (src - imageSrc0Origin()) / imageSrc0Size()
	n := noise(uv*5)*0.65 + noise(uv*11)*0.35
	// Thin parts of the sprite (its soft edge) burn first. The value noise
	// sits around 0.25..0.85; the remap spreads the burn of a solid sprite
	// over the whole life.
	v := (mix(n, tex.a, 0.35) - 0.45) / 0.45
	left := v - burned
	if left <= 0 {
		return vec4(0)
	}
	glow := 0.0
	if Params.x > 0 {
		glow = 1 - smoothstep(0, Params.x, left)
	}
	// color is premultiplied: divide the alpha out to get the tint.
	rgb := mix(tex.rgb*color.rgb/color.a, Params.yzw, glow)
	a := tex.a * smoothstep(0, 0.02, left)
	return vec4(rgb*a, a)
}
