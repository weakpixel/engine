//kage:unit pixels

package main

// Params.x: the brightness above which a pixel glows, 0..1.
var Params vec4

// glow keeps the part of c above the threshold, scaled so that hue stays.
func glow(c vec4) vec3 {
	l := max(c.r, max(c.g, c.b))
	return c.rgb * (max(l-Params.x, 0) / max(l, 0.0001))
}

// Fragment writes a half-size image: src is the corner of a 2x2 block of
// frame pixels, and the four taps are their centers.
func Fragment(dst vec4, src vec2, color vec4) vec4 {
	c := glow(imageSrc0At(src+vec2(-0.5, -0.5))) +
		glow(imageSrc0At(src+vec2(0.5, -0.5))) +
		glow(imageSrc0At(src+vec2(-0.5, 0.5))) +
		glow(imageSrc0At(src+vec2(0.5, 0.5)))
	return vec4(c*0.25, 1)
}
