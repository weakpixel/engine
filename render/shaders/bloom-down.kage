//kage:unit pixels

package main

// Fragment averages each 2x2 block of the source into one pixel.
func Fragment(dst vec4, src vec2, color vec4) vec4 {
	c := imageSrc0At(src+vec2(-0.5, -0.5)) +
		imageSrc0At(src+vec2(0.5, -0.5)) +
		imageSrc0At(src+vec2(-0.5, 0.5)) +
		imageSrc0At(src+vec2(0.5, 0.5))
	return c * 0.25
}
