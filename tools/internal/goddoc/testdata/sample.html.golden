<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sample</title>
<style>
:root {
  --bg: #fff; --fg: #1f2328; --muted: #656d76; --border: #d0d7de; --panel: #f6f8fa;
  --accent: #0969da; --badge-bg: #ddf4ff; --badge-fg: #0550ae;
  --embed-bg: #fff8c5; --embed-fg: #7d4e00;
}
 
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0d1117; --fg: #e6edf3; --muted: #8d96a0; --border: #30363d; --panel: #161b22;
    --accent: #58a6ff; --badge-bg: #10243e; --badge-fg: #79c0ff;
    --embed-bg: #3b2e00; --embed-fg: #e3b341;
  }
}
:root[data-theme="dark"] {
  --bg: #0d1117; --fg: #e6edf3; --muted: #8d96a0; --border: #30363d; --panel: #161b22;
  --accent: #58a6ff; --badge-bg: #10243e; --badge-fg: #79c0ff;
  --embed-bg: #3b2e00; --embed-fg: #e3b341;
}
:root { color-scheme: light dark; }
:root[data-theme="light"] { color-scheme: light; }
:root[data-theme="dark"] { color-scheme: dark; }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.5 system-ui, sans-serif; display: flex; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
nav { position: sticky; top: 0; align-self: flex-start; width: 280px; height: 100vh; overflow-y: auto;
  padding: 16px; border-right: 1px solid var(--border); background: var(--panel); flex-shrink: 0; }
nav h1 { font-size: 17px; margin: 0 0 12px; }
nav input { width: 100%; padding: 6px 8px; margin-bottom: 12px; color: inherit; background: var(--bg);
  border: 1px solid var(--border); border-radius: 6px; }
.theme { display: none; float: right; padding: 2px 8px; cursor: pointer; color: inherit; background: var(--bg);
  border: 1px solid var(--border); border-radius: 6px; font-size: 13px; }
.js .theme { display: block; }
.tabs { display: none; gap: 4px; margin-bottom: 8px; }
.js .tabs { display: flex; }
.tabs button { flex: 1; padding: 4px; cursor: pointer; color: inherit; background: var(--bg);
  border: 1px solid var(--border); border-radius: 6px; }
.tabs button[aria-selected="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }
nav h2 { font-size: 12px; text-transform: uppercase; color: var(--muted); margin: 16px 0 4px; }
nav ul { list-style: none; margin: 0; padding: 0; }
nav li { padding: 1px 0; }
nav ul ul { padding-left: 12px; }
[hidden] { display: none !important; }
main { flex: 1; min-width: 0; max-width: 900px; padding: 8px 32px 64px; }
section { padding-top: 24px; }
h2.part { border-bottom: 1px solid var(--border); padding-bottom: 4px; margin-top: 40px; }
h3 { margin: 0 0 4px; }
p { margin: 8px 0; white-space: pre-line; }
table { border-collapse: collapse; width: 100%; margin: 8px 0; font-size: 14px; }
th, td { border: 1px solid var(--border); padding: 4px 8px; text-align: left; vertical-align: top; }
th { background: var(--panel); }
code { font: 13px ui-monospace, monospace; }
ul.values { margin: 4px 0 0; padding-left: 18px; }
.badge { display: inline-block; padding: 0 6px; margin-right: 4px; border-radius: 10px; font-size: 12px;
  background: var(--badge-bg); color: var(--badge-fg); }
.badge.embedded { background: var(--embed-bg); color: var(--embed-fg); }
details { margin: 8px 0; }
summary { cursor: pointer; color: var(--muted); }
.used { color: var(--muted); font-size: 14px; }
@media (max-width: 760px) {
  body { display: block; }
  nav { position: static; width: auto; height: auto; border-right: 0; border-bottom: 1px solid var(--border); }
  main { padding: 8px 16px 48px; }
}
</style>
<script>
 
try { var t = localStorage.getItem("god-doc-theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
</script>
</head>
<body>
<nav>
<button type="button" class="theme" id="theme" aria-label="Switch between light and dark mode"></button>
<h1>Sample</h1>
<input type="search" id="filter" placeholder="Filter objects and components" aria-label="Filter">
<div class="tabs" role="tablist">
<button type="button" role="tab" data-tab="objects" aria-selected="true">Objects</button>
<button type="button" role="tab" data-tab="components" aria-selected="false">Components</button>
</div>
<div id="tab-objects">
<h2>Objects</h2>
<ul>
<li>ext
<ul>
<li data-filter="ext:Thing"><a href="#obj-ext-Thing">Thing</a></li>
</ul></li>
<li>game
<ul>
<li data-filter="game:Boss"><a href="#obj-game-Boss">Boss</a></li>
<li data-filter="game:Hero"><a href="#obj-game-Hero">Hero</a></li>
</ul></li>
</ul>
</div>
<div id="tab-components">
<h2>Components</h2>
<ul>
<li data-filter="ext:Stamp"><a href="#comp-ext-Stamp">ext:Stamp</a></li>
<li data-filter="ext:Transform"><a href="#comp-ext-Transform">ext:Transform</a></li>
<li data-filter="game:Companion"><a href="#comp-game-Companion">game:Companion</a></li>
<li data-filter="game:Health"><a href="#comp-game-Health">game:Health</a></li>
<li data-filter="game:Score"><a href="#comp-game-Score">game:Score</a></li>
<li data-filter="game:Transform"><a href="#comp-game-Transform">game:Transform</a></li>
<li data-filter="game:Weapon"><a href="#comp-game-Weapon">game:Weapon</a></li>
</ul>
</div>
</nav>
<main>
<h2 class="part">Objects</h2>
<section id="obj-ext-Thing" data-filter="ext:Thing">
<h3>ext:Thing</h3>
<p>Thing has its own Transform.</p>
<table>
<thead><tr><th>Component</th><th>Field</th><th>Flags</th><th>Description</th></tr></thead>
<tbody>
<tr><td><a href="#comp-ext-Transform">ext:Transform</a></td><td><code>Transform</code></td>
<td></td>
<td></td></tr>
<tr><td><a href="#comp-ext-Stamp">ext:Stamp</a></td><td><code>Stamp</code></td>
<td></td>
<td></td></tr>
</tbody>
</table>
</section>
<section id="obj-game-Boss" data-filter="game:Boss">
<h3>game:Boss</h3>
<table>
<thead><tr><th>Component</th><th>Field</th><th>Flags</th><th>Description</th></tr></thead>
<tbody>
<tr><td><a href="#comp-game-Transform">game:Transform</a></td><td><code>Transform</code></td>
<td><span class="badge embedded">embedded (Common)</span></td>
<td></td></tr>
</tbody>
</table>
</section>
<section id="obj-game-Hero" data-filter="game:Hero">
<h3>game:Hero</h3>
<p>Hero is the player character.</p>
<p>It can carry a weapon.</p>
<table>
<thead><tr><th>Component</th><th>Field</th><th>Flags</th><th>Description</th></tr></thead>
<tbody>
<tr><td><a href="#comp-game-Transform">game:Transform</a></td><td><code>Transform</code></td>
<td><span class="badge embedded">embedded (Common.Base)</span></td>
<td>Where the hero is.</td></tr>
<tr><td><a href="#comp-game-Health">game:Health</a></td><td><code>Health</code></td>
<td></td>
<td>Stores the hero&#39;s health.</td></tr>
<tr><td><a href="#comp-game-Companion">game:Companion</a></td><td><code>Companion</code></td>
<td><span class="badge">readonly</span></td>
<td></td></tr>
<tr><td><a href="#comp-game-Weapon">game:Weapon</a></td><td><code>Weapon</code></td>
<td><span class="badge">optional</span></td>
<td>The weapon the hero carries, if any.</td></tr>
</tbody>
</table>
</section>
<h2 class="part">Components</h2>
<section id="comp-ext-Stamp" data-filter="ext:Stamp">
<h3>ext:Stamp</h3>
<p>Go type: <code>example.com/ext.Stamp</code></p>
<p>Type: <code>time.Time</code></p>
<p class="used">Used by: <a href="#obj-ext-Thing">ext:Thing</a></p>
</section>
<section id="comp-ext-Transform" data-filter="ext:Transform">
<h3>ext:Transform</h3>
<p>A transform with a name.</p>
<p>Go type: <code>example.com/ext.Transform</code></p>
<details open>
<summary>Fields</summary>
<table>
<thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Nullable</th><th>Description</th></tr></thead>
<tbody>
<tr><td><code>Label</code></td><td><code>string</code></td><td>yes</td><td></td><td></td></tr>
</tbody>
</table>
</details>
<p class="used">Used by: <a href="#obj-ext-Thing">ext:Thing</a></p>
</section>
<section id="comp-game-Companion" data-filter="game:Companion">
<h3>game:Companion</h3>
<p>Go type: <code>example.com/game.Companion</code></p>
<details open>
<summary>Fields</summary>
<table>
<thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Nullable</th><th>Description</th></tr></thead>
<tbody>
<tr><td><code>Attachment</code></td><td><code>object</code></td><td></td><td>yes</td><td></td></tr>
<tr><td><code>Attachment.Name</code></td><td><code>string</code></td><td>yes</td><td></td><td></td></tr>
<tr><td><code>Name</code></td><td><code>string</code></td><td>yes</td><td></td><td></td></tr>
<tr><td><code>Owner</code></td><td><code>reference to another object</code></td><td></td><td>yes</td><td>The object that owns the companion.</td></tr>
<tr><td><code>Tags</code></td><td><code>array of string</code></td><td></td><td>yes</td><td></td></tr>
</tbody>
</table>
</details>
<p class="used">Used by: <a href="#obj-game-Hero">game:Hero</a></p>
</section>
<section id="comp-game-Health" data-filter="game:Health">
<h3>game:Health</h3>
<p>Health is hit points.</p>
<p>It never drops below zero.</p>
<p>Go type: <code>example.com/game.Health</code></p>
<details open>
<summary>Fields</summary>
<table>
<thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Nullable</th><th>Description</th></tr></thead>
<tbody>
<tr><td><code>Current</code></td><td><code>integer (int64)</code></td><td>yes</td><td></td><td></td></tr>
<tr><td><code>Max</code></td><td><code>integer (int64)</code></td><td>yes</td><td></td><td></td></tr>
</tbody>
</table>
</details>
<p class="used">Used by: <a href="#obj-game-Hero">game:Hero</a></p>
</section>
<section id="comp-game-Score" data-filter="game:Score">
<h3>game:Score</h3>
<p>Score is not used by any object yet.</p>
<p>Go type: <code>example.com/game.Score</code></p>
<details open>
<summary>Fields</summary>
<table>
<thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Nullable</th><th>Description</th></tr></thead>
<tbody>
<tr><td><code>Mode</code></td><td><code>enum (ScoreSum, ScoreBest)</code></td><td>yes</td><td></td><td>How points are counted.<ul class="values"><li><code>0 ScoreSum</code>: Every point counts.</li><li><code>1 ScoreBest</code></li></ul> <span class="default">Default: <code>ScoreBest</code></span></td></tr>
<tr><td><code>Points</code></td><td><code>integer (int64)</code></td><td>yes</td><td></td><td> <span class="default">Default: <code>10</code></span></td></tr>
</tbody>
</table>
</details>
<p class="used">Used by: <em>no object yet</em></p>
</section>
<section id="comp-game-Transform" data-filter="game:Transform">
<h3>game:Transform</h3>
<p>Transform is a position.</p>
<p>Go type: <code>example.com/game.Transform</code></p>
<details open>
<summary>Fields</summary>
<table>
<thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Nullable</th><th>Description</th></tr></thead>
<tbody>
<tr><td><code>X</code></td><td><code>number (double)</code></td><td>yes</td><td></td><td>Horizontal | position.</td></tr>
<tr><td><code>Y</code></td><td><code>number (double)</code></td><td>yes</td><td></td><td></td></tr>
</tbody>
</table>
</details>
<p class="used">Used by: <a href="#obj-game-Boss">game:Boss</a> <span class="badge embedded">embedded (Common)</span> <a href="#obj-game-Hero">game:Hero</a> <span class="badge embedded">embedded (Common.Base)</span></p>
</section>
<section id="comp-game-Weapon" data-filter="game:Weapon">
<h3>game:Weapon</h3>
<p>Go type: <code>example.com/game.Weapon</code></p>
<details open>
<summary>Fields</summary>
<table>
<thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Nullable</th><th>Description</th></tr></thead>
<tbody>
<tr><td><code>Cooldown</code></td><td><code>number (double)</code> <em>(runtime)</em></td><td></td><td></td><td></td></tr>
<tr><td><code>Damage</code></td><td><code>number (double)</code></td><td>yes</td><td></td><td></td></tr>
<tr><td><code>Icon</code></td><td><code>asset (sprite)</code></td><td></td><td></td><td></td></tr>
</tbody>
</table>
</details>
<p class="used">Used by: <a href="#obj-game-Hero">game:Hero</a></p>
</section>
</main>
<script>
(function () {
  document.documentElement.classList.add("js");
  var root = document.documentElement, themeBtn = document.getElementById("theme");
  var query = window.matchMedia("(prefers-color-scheme: dark)");
  function effective() { return root.dataset.theme || (query.matches ? "dark" : "light"); }
  function label() { themeBtn.textContent = effective() === "dark" ? "Light mode" : "Dark mode"; }
  themeBtn.addEventListener("click", function () {
    var next = effective() === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("god-doc-theme", next); } catch (e) {}
    label();
  });
  query.addEventListener("change", label);
  label();
  var tabs = document.querySelectorAll("[data-tab]");
  function show(name) {
    tabs.forEach(function (b) { b.setAttribute("aria-selected", String(b.dataset.tab === name)); });
    document.getElementById("tab-objects").hidden = name !== "objects";
    document.getElementById("tab-components").hidden = name !== "components";
  }
  tabs.forEach(function (b) { b.addEventListener("click", function () { show(b.dataset.tab); }); });
  show("objects");
  document.getElementById("filter").addEventListener("input", function (e) {
    var q = e.target.value.toLowerCase();
    document.querySelectorAll("[data-filter]").forEach(function (el) {
      el.hidden = q !== "" && el.dataset.filter.toLowerCase().indexOf(q) < 0;
    });
  });
})();
</script>
</body>
</html>
