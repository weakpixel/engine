// "ecs: not bound to a world" if MidView is the zero value.
func (v MidView) Has(e ecs.Entity) bool {
	if v.world == nil {
		panic("ecs: not bound to a world")
	}
	return v.view.Has(e)
}

// Set writes obj to e: required components are added or replaced (a nil
// required pointer overwrites the component with its zero value); optional
// components are added or replaced when non-nil and removed when nil.
// Components of e that are not part of Mid are left untouched.
//
// Panics with "ecs: not bound to a world" if MidView is the zero value.
func (v MidView) Set(e ecs.Entity, obj Mid) {
	if v.world == nil {
		panic("ecs: not bound to a world")
	}
	var v0 A
	if obj.Base.A != nil {
		v0 = *obj.Base.A
	}
	var v1 B
	if obj.B != nil {
		v1 = *obj.B
	}
	v.view.Set(e, v0, v1)
}

// Remove removes all of Mid's components (required and optional)
// that e has, in one archetype move. Other components stay.
//
// Panics with "ecs: not bound to a world" if MidView is the zero value.
func (v MidView) Remove(e ecs.Entity) {
	if v.world == nil {
		panic("ecs: not bound to a world")
	}
	v.world.RemoveComp(e, CID_A, CID_B)
}

// Each yields every entity that has all required components of Mid,
// regardless of how it was created. Optional fields are always resolved, so
// Each yields the same Mid that Get would return for the same
// entity.
//
// Panics with "ecs: not bound to a world" if MidView is the zero value.
func (v MidView) Each() iter.Seq2[ecs.Entity, Mid] {
	if v.world == nil {
		panic("ecs: not bound to a world")
	}
	return func(yield func(ecs.Entity, Mid) bool) {
		for e, comp := range v.view.Each() {
			var obj Mid
			obj.Base.A = comp.Comp1
			obj.B = comp.Comp2
			if !yield(e, obj) {
				return
			}
		}
	}
}

// NewTopView returns a TopView bound to world. Create it once
// and keep it; copies share the same underlying state.
func NewTopView(world *ecs.World) TopView {
	return TopView{
		world: world,
		view:  ecs.NewView3[A, B, C](world),
	}
}

// TopView is a thin handle over Top entities, bound to one
// World. It holds no entity state of its own.
type TopView struct {
	world *ecs.World
	view  ecs.View3[A, B, C]
}

// NewEntity creates an entity from obj. A nil required pointer component is
// stored as the zero value. An optional component is added only when
// non-nil.
//
// Panics with "ecs: not bound to a world" if TopView is the zero value.
func (v TopView) NewEntity(obj Top) ecs.Entity {
	if v.world == nil {
		panic("ecs: not bound to a world")
	}
	if obj.Mid == nil {
		obj.Mid = &Mid{}
	}
	var v0 A
	if obj.Mid.Base.A != nil {
		v0 = *obj.Mid.Base.A
	}
	var v1 B
	if obj.Mid.B != nil {
		v1 = *obj.Mid.B
	}
	var v2 C
	if obj.C != nil {
		v2 = *obj.C
	}
	return v.view.NewEntity(v0, v1, v2)
}

// Get returns a Top whose component fields point to e's live
// components. Optional fields are resolved (nil when absent). Panics if e
// lacks a required component, and with "ecs: not bound to a world" if
// TopView is the zero value.
func (v TopView) Get(e ecs.Entity) Top {
	if v.world == nil {
		panic("ecs: not bound to a world")
	}
	var obj Top
	obj.Mid = &Mid{}
	comp := v.view.Get(e)
	obj.Mid.Base.A = comp.Comp1
	obj.Mid.B = comp.Comp2
	obj.C = comp.Comp3
	return obj
}

// Has reports whether e has every required component of Top, i.e.
// whether Get would not panic. Panics if e is stale, and with
// "ecs: not bound to a world" if TopView is the zero value.
func (v TopView) Has(e ecs.Entity) bool {
	if v.world == nil {
		panic("ecs: not bound to a world")
	}
	return v.view.Has(e)
}

// Set writes obj to e: required components are added or replaced (a nil
// required pointer overwrites the component with its zero value); optional
// components are added or replaced when non-nil and removed when nil.
// Components of e that are not part of Top are left untouched.
//
// Panics with "ecs: not bound to a world" if TopView is the zero value.
func (v TopView) Set(e ecs.Entity, obj Top) {
	if v.world == nil {
		panic("ecs: not bound to a world")
	}
	if obj.Mid == nil {
		obj.Mid = &Mid{}
	}
	var v0 A
	if obj.Mid.Base.A != nil {
		v0 = *obj.Mid.Base.A
	}
	var v1 B
	if obj.Mid.B != nil {
		v1 = *obj.Mid.B
	}
	var v2 C
	if obj.C != nil {
		v2 = *obj.C
	}
	v.view.Set(e, v0, v1, v2)
}

// Remove removes all of Top's components (required and optional)
// that e has, in one archetype move. Other components stay.
//
// Panics with "ecs: not bound to a world" if TopView is the zero value.
func (v TopView) Remove(e ecs.Entity) {
	if v.world == nil {
		panic("ecs: not bound to a world")
	}
	v.world.RemoveComp(e, CID_A, CID_B, CID_C)
}

// Each yields every entity that has all required components of Top,
// regardless of how it was created. Optional fields are always resolved, so
// Each yields the same Top that Get would return for the same
// entity.
//
// Panics with "ecs: not bound to a world" if TopView is the zero value.
func (v TopView) Each() iter.Seq2[ecs.Entity, Top] {
	if v.world == nil {
		panic("ecs: not bound to a world")
	}
	return func(yield func(ecs.Entity, Top) bool) {
		for e, comp := range v.view.Each() {
			var obj Top
			obj.Mid = &Mid{}
			obj.Mid.Base.A = comp.Comp1
			obj.Mid.B = comp.Comp2
			obj.C = comp.Comp3
			if !yield(e, obj) {
				return
			}
		}
	}
}
